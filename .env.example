# Secret used to sign session JWTs. Generate a long random string for production.
AUTH_SECRET=

# Owner's personal password — grants the "owner" role (includes /admin access).
OWNER_PASSWORD=

# Shared access key handed out to guests — grants the "guest" role (demo access only).
# In production this is read from Vercel Edge Config first (key: "accessKey"), falling
# back to this env var if Edge Config isn't provisioned yet.
ACCESS_KEY=
